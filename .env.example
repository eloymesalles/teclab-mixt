# Còpia aquest fitxer a .env (ignorat per git) per a proves locals de la imatge.
# La imatge no porta cap adreça de passarel·la: la posa la plataforma a l'entorn de l'espai.
#   Demo (mesalles.org):           https://api.mesalles.org/v1
#   Sandbox del Teclab (GCP):      https://llm-teclab.uji.es:4443/v1  (només des de dins de la VPC)
LITELLM_BASE_URL=
# Clau virtual creada a l'administració de LiteLLM de la plataforma (Virtual Keys). Mai al git.
LITELLM_KEY=
# Àlies del catàleg (el mateix a les dues plataformes); chat-default si es deixa buit
LITELLM_MODEL=chat-default
# Claude Code per la passarel·la («claude»): noms dels models de Claude al catàleg de la
# passarel·la (al Teclab, claude-sonnet-5.5 i claude-haiku-5.5). Buits = «claude» no arrenca.
CLAUDE_MODEL_SONNET=
CLAUDE_MODEL_HAIKU=
