#!/bin/sh
# Embolcall de Codex CLI per a teclab-mixt (instal·lat a /usr/local/bin/codex).
#
# El primer cop que s'executa en un home genera ~/.codex/config.toml a partir de
# l'entorn de l'espai (LITELLM_BASE_URL, CODEX_MODEL) i tot seguit llança Codex.
# Així val tant per a Coder com per a JupyterHub, i també per als homes ja creats.
# La clau NO s'escriu mai al fitxer: Codex la llegeix de la variable LITELLM_KEY
# (env_key), que posen Coder o JupyterHub a l'entorn de l'espai.
set -eu

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CFG="$CODEX_HOME/config.toml"

# L'adreça de la passarel·la depèn de la plataforma (demo o Teclab): la imatge no en té cap.
if [ -z "${LITELLM_BASE_URL:-}" ]; then
  echo "codex: falta LITELLM_BASE_URL a l'entorn de l'espai (la posa Coder o JupyterHub)" >&2
  exit 2
fi

if [ ! -e "$CFG" ]; then
  mkdir -p "$CODEX_HOME"
  umask 077
  cat > "$CFG" <<EOF
# Generat per /usr/local/bin/codex (teclab-mixt) en el primer ús. Edita'l lliurement:
# no es torna a generar mentre existeixi. Esborra'l per regenerar-lo amb l'entorn actual.

# Model de la passarel·la (OpenAI darrere de LiteLLM; el consum compta contra la clau del projecte)
model = "${CODEX_MODEL:-gpt-6.1-sol}"
model_provider = "teclab"

# Mode conservador: llegeix lliurement, però demana confirmació per a ordres i escriptures
approval_policy = "on-request"
sandbox_mode = "read-only"

check_for_update_on_startup = false

[analytics]
enabled = false

# Passarel·la Teclab. Codex només parla l'API Responses, que LiteLLM serveix a /v1/responses.
[model_providers.teclab]
name = "Passarel·la Teclab (LiteLLM)"
base_url = "${LITELLM_BASE_URL}"
env_key = "LITELLM_KEY"
wire_api = "responses"

[projects."$HOME/work"]
trust_level = "trusted"
EOF
fi

if [ -z "${LITELLM_KEY:-}" ]; then
  echo "codex: falta LITELLM_KEY a l'entorn de l'espai (la posa Coder o JupyterHub)" >&2
fi

exec node /usr/local/lib/node_modules/@openai/codex/bin/codex.js "$@"
